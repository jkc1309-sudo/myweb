{% from "macros.j2" import site_footer %}
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ work.detail_title or work.title }} | 金可成</title>
    <meta name="description" content="{{ work.description or work.summary }}" />
    <link rel="stylesheet" href="../styles.css?v={{ site.css_version }}" />
    <script defer src="../script.js"></script>
  </head>
  <body data-page="project" data-nav="{{ 'research' if work.type == 'research' else 'projects' }}">
    <div class="site-shell" id="top">
      <header class="site-header">
        <a class="brand" href="../index.html">
          <span class="brand-script">Kecheng</span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-label="打开导航">
          <span></span>
          <span></span>
        </button>
        <div class="header-end">
          <nav class="site-nav" aria-label="页面导航">
            <a href="../index.html#about" data-section="about">简介</a>
            <a href="../index.html#projects" data-section="projects">项目</a>
            <a href="../index.html#research" data-section="research">研究</a>
            <a href="../index.html#honors" data-section="honors">荣誉</a>
            <a href="../index.html#contact" data-section="contact">联系</a>
            <a class="nav-cta" href="../cv.html" data-section="cv">简历</a>
          </nav>
          <nav class="lang-switch" aria-label="语言">
            <a href="../index.html#{{ 'research' if work.type == 'research' else 'projects' }}" aria-current="page">中</a>
            <span aria-hidden="true">/</span>
            <a href="{{ work.en_href or '../en/projects.html' }}" hreflang="en">EN</a>
          </nav>
        </div>
      </header>

      <main>
        <section class="page-intro reveal">
          <nav class="breadcrumb" aria-label="面包屑">
            <a href="../index.html">首页</a>
            <span>/</span>
            <a href="../index.html#{{ 'research' if work.type == 'research' else 'projects' }}">{{ '研究' if work.type == 'research' else '项目' }}</a>
            <span>/</span>
            <span>{{ work.breadcrumb or work.title }}</span>
          </nav>
          <div class="detail-hero">
            <p class="eyebrow">{{ work.eyebrow }}</p>
            <h1>{{ work.detail_title or work.title }}</h1>
            <p class="detail-meta">
              {% for item in work.detail_meta %}
              <span>{{ item }}</span>
              {% endfor %}
            </p>
            <p class="lead">{{ work.lead }}</p>
          </div>
          {% if work.cover %}
          <div class="detail-cover">
            <img src="../{{ work.cover }}" alt="{{ work.cover_alt or work.title }}" />
          </div>
          {% endif %}
        </section>

        <section class="section reveal">
          <div class="detail-prose">
            {% if work.background %}
            <h2>背景与问题</h2>
            <p>{{ work.background }}</p>
            {% endif %}
            {% if work.duties %}
            <h2>我的职责</h2>
            <ul>
              {% for item in work.duties %}
              <li>{{ item }}</li>
              {% endfor %}
            </ul>
            {% endif %}
            {% if work.solution %}
            <h2>方案与实现</h2>
            <p>{{ work.solution }}</p>
            {% endif %}
            {% if work.outcome or work.metrics or (work.paper and work.paper.title) %}
            <h2>结果与验证</h2>
            {% endif %}
            {% if work.outcome %}
            <p>{{ work.outcome }}</p>
            {% endif %}
            {% if work.metrics %}
            <div class="result-callout">
              {% for metric in work.metrics %}
              <article>
                <strong>{{ metric.value }}</strong>
                <span>{{ metric.label }}</span>
              </article>
              {% endfor %}
            </div>
            {% endif %}
            {% if work.paper and work.paper.title %}
            <p>
              研究成果：<em>{{ work.paper.title }}</em>{% if work.paper.venue %}（{{ work.paper.venue }}）{% endif %}
              {% if work.paper.doi %}
              {% set doi_url = work.paper.doi if work.paper.doi.startswith('http') else 'https://doi.org/' + work.paper.doi %}
              <a href="{{ doi_url }}" target="_blank" rel="noopener">DOI: {{ work.paper.doi | replace('https://doi.org/', '') }}</a>
              {% endif %}
            </p>
            {% endif %}
            {% if work.lists %}
            <h2>落地清单</h2>
            {% for group in work.lists %}
            <p>{{ group.title }}</p>
            <ul class="venue-list">
              {% for item in group['items'] %}
              <li>{{ item }}</li>
              {% endfor %}
            </ul>
            {% endfor %}
            {% endif %}
            {% if work.gallery %}
            <div class="detail-gallery">
              {% for shot in work.gallery %}
              <figure>
                <img src="../{{ shot.src }}" alt="{{ shot.alt or work.title }}" />
              </figure>
              {% endfor %}
            </div>
            {% endif %}
            {% if work.links %}
            <p>
              {% for link in work.links %}
              <a class="button button-secondary" href="{{ link.url }}" target="_blank" rel="noopener">{{ link.label }}</a>
              {% endfor %}
            </p>
            {% endif %}
          </div>
        </section>

        <section class="section alt reveal">
          <div class="project-pager">
            {% if prev %}
            <a href="{{ prev.slug }}.html">← {{ prev.breadcrumb or prev.title }}</a>
            {% else %}
            <span></span>
            {% endif %}
            {% if next %}
            <a href="{{ next.slug }}.html">{{ next.breadcrumb or next.title }} →</a>
            {% endif %}
          </div>
        </section>
      </main>

      {{ site_footer(site) }}
    </div>
    <button class="back-to-top" type="button" aria-label="返回顶部">↑</button>
  </body>
</html>
